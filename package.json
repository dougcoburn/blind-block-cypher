{
  "name": "blind-block-cypher",
  "version": "0.2.1",
  "description": "Keyed Feistel ciphers for ID obfuscation: opaque, locally unique 16-char IDs that hide creation time, plus format-preserving 32-bit integer encryption",
  "keywords": [
    "id",
    "unique-id",
    "nanoid",
    "snowflake",
    "feistel",
    "format-preserving-encryption",
    "obfuscation",
    "hmac",
    "skip32"
  ],
  "homepage": "https://github.com/dougcoburn/blind-block-cypher#readme",
  "bugs": {
    "url": "https://github.com/dougcoburn/blind-block-cypher/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dougcoburn/blind-block-cypher.git"
  },
  "license": "MIT",
  "author": "Doug Coburn",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "files": [
    "dist/*",
    "LICENSE"
  ],
  "scripts": {
    "bench": "tsup scripts/bench.ts --format cjs --out-dir node_modules/.cache/bench --silent && node node_modules/.cache/bench/bench.js",
    "build": "tsup src/index.ts --format cjs,esm --dts",
    "ci": "pnpm run lint && pnpm run test && pnpm run build && pnpm run lint:package && pnpm run smoke:pack",
    "dev": "vitest",
    "lint": "prettier . --check && eslint . && cspell \"src/**\" && tsc",
    "lint:fix": "prettier . --write -w && eslint . --fix && tsc",
    "lint:package": "publint && attw --pack .",
    "release": "pnpm run lint && pnpm run test && pnpm run build && pnpm run lint:package && pnpm run smoke:pack && changeset publish",
    "smoke:pack": "node scripts/pack-smoke.mjs",
    "test": "vitest run --coverage"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@changesets/cli": "^2.31.1",
    "@types/node": "^20.19.43",
    "@typescript-eslint/eslint-plugin": "^5.62.0",
    "@typescript-eslint/parser": "^5.62.0",
    "@vitest/coverage-istanbul": "^4.1.11",
    "cspell": "^8.19.4",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^8.10.2",
    "eslint-plugin-deprecation": "^1.5.0",
    "eslint-plugin-eslint-comments": "^3.2.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsdoc": "^46.10.1",
    "eslint-plugin-markdown": "^3.0.1",
    "eslint-plugin-n": "^16.6.2",
    "eslint-plugin-perfectionist": "^1.5.1",
    "eslint-plugin-vitest": "^0.2.8",
    "eslint-plugin-yml": "^1.19.1",
    "prettier": "^2.8.8",
    "prettier-plugin-curly": "^0.1.3",
    "prettier-plugin-packagejson": "^2.5.22",
    "publint": "^0.3.25",
    "tsup": "^8.5.1",
    "typescript": "^5.1.3",
    "vitest": "^4.1.11",
    "yaml-eslint-parser": "^1.3.2"
  },
  "publishConfig": {
    "access": "public"
  },
  "pnpm": {
    "overrides": {
      "esbuild@>=0.27.3 <0.28.1": "0.27.2",
      "minimatch@>=9.0.0 <9.0.7": "^9.0.9",
      "read-yaml-file@1": "2.1.0"
    }
  }
}
